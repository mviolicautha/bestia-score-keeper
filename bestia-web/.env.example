# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Project Settings → API). Senza questi valori l'app salva tutto in locale.
# .env.local non va su git (è nel .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
